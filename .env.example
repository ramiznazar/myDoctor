# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/mydoctore

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Redis Configuration (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email (Aruba SMTP)
# Keep actual credentials only in your local/production .env file.
EMAIL_ENABLED=true
EMAIL_PROVIDER=aruba
SMTP_HOST=smtps.aruba.it
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=My Doctor
SMTP_REPLY_TO=
SMTP_ENVELOPE_FROM=
SMTP_MESSAGE_ID_DOMAIN=
EMAIL_VERIFY_ON_STARTUP=true
EMAIL_MAX_CONCURRENCY=3
APP_URL=http://localhost:5173

# Administrator credential rotation (used only by `npm run seed:admin`)
# Set ADMIN_CURRENT_EMAIL when changing the email of an existing admin.
ADMIN_EMAIL=
# Use at least 8 characters; use a unique, strong password in production.
ADMIN_PASSWORD=
ADMIN_NAME=My Doctor Administrator
ADMIN_CURRENT_EMAIL=

